# Dropzyy Environment Variables Template
# Copy this file to .env and fill in your actual credentials

# Database Settings
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dropzyy?retryWrites=true&w=majority
MONGODB_DB_NAME=dropzyy

# JWT Authentication
SECRET_KEY=generate-a-strong-random-secret-key-for-jwt-signing
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Seeded Account Passwords
ADMIN_PASSWORD=SetAStrongAdminPasswordHere!
YASH_ADMIN_PASSWORD=SetAStrongPasswordHere!
SUPPLIER_PASSWORD=SetAStrongSupplierPasswordHere!

# CORS Allowed Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://dropzyy.onrender.com

# Email & SMS Service Keys
RESEND_API_KEY=
SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=
ADMIN_EMAIL=supportdropzyy@gmail.com
ADMIN_MOBILE_NUMBER=+919876543210
ENABLE_PAID_SMS=False
